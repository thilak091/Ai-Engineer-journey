   "source": [
    "#Challenge 1\n",
    "from sklearn.cluster import DBSCAN\n",
    "\n",
    "data = [\n",
    "    [1,1], [1.2,1.1], [0.8,1.2], [1.1,0.9],\n",
    "    [8,8], [8.2,8.1], [7.8,8.2], [8.1,7.9],\n",
    "    [20,20]\n",
    "]\n",
    "\n",
    "db = DBSCAN(eps=0.5, min_samples=3)\n",
    "labels=db.fit_predict(data)\n",
    "print(labels)\n",
    "\n",
    "print(db.core_sample_indices_)"
   ]
  },
